# Python Interview System Environment Variables

# Server Configuration for Local Machine
PORT="8000"
BASE_URL="http://localhost:8000"  # Update if deploying on a server

# MongoDB Configuration
MONGODB_URI="mongodb://localhost:27017/"  # Replace with your MongoDB URI

# OpenAI Configuration
OPENAI_API_KEY="enter your OpenAI API key here"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="enter your Google OAuth client ID here"
GOOGLE_CLIENT_SECRET="enter your Google OAuth client secret here"
GOOGLE_REDIRECT_URI="e.g., http://localhost:8000/auth/google/callback"
GOOGLE_CALENDAR_TIMEZONE="Asia/Kolkata"  # Change if needed

# Google Apps Script
GOOGLE_APPS_SCRIPT_ID="enter your Google Apps Script ID here"

LOG_LEVEL="DEBUG"  # Options: DEBUG, INFO, WARNING, ERROR

# Telnyx Configuration
TELNYX_API_KEY="enter your Telnyx API key here"
TELNYX_CONNECTION_ID="enter your Telnyx connection ID here"
TELNYX_WEBHOOK_URL="https://your-public-url.com/telnyx/webhook"
TELNYX_PHONE_NUMBER="+1234567890"  # Format: E.164 (e.g., +15551234567)
TELNYX_NUMBER="+1234567890"  # Format: E.164 (e.g., +15551234567)"

# Webhooks
WEBHOOK_URL="https://your-public-url.com/webhook"
PUBLIC_URL="https://your-public-url.com"